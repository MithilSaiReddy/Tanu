{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tanu",
  "version": "0.1.0",
  "identifier": "com.tanu.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tanu",
        "label": "main",
        "width": 60,
        "height": 60,
        "minWidth": 60,
        "minHeight": 60,
        "maxWidth": 450,
        "maxHeight": 650,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "resizable": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
